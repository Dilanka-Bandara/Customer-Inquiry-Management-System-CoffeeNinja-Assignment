# Copy this file to `.env` (cp .env.example .env). Values match docker-compose.yml.
DATABASE_URL="postgresql://inquiry:inquiry@localhost:5434/inquiry_dev"
# Used by automated tests only (separate database, created by docker-compose)
TEST_DATABASE_URL="postgresql://inquiry:inquiry@localhost:5434/inquiry_test"

# Secret used to sign login tokens. Use a long random string outside local dev.
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000
# The frontend URL allowed to call the API with cookies (CORS)
CLIENT_ORIGIN="http://localhost:5173"
